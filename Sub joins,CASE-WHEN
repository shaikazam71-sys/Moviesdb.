FULL OUTER JOIN (Using UNION)

SELECT title, studio_name
FROM movies m
LEFT JOIN studios s
USING (studio_id)

UNION

SELECT title, studio_name
FROM movies m
RIGHT JOIN studios s
USING (studio_id);

